# Stripe production secrets. Never commit real secret keys.
STRIPE_SECRET_KEY=replace_with_rotated_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_me_when_webhook_is_ready

# Supabase project settings. Keep the service role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_service_role_key

# Admin access token for /admin/login
ADMIN_ACCESS_TOKEN=replace_with_a_long_random_admin_token

# Optional new-order email notifications. Use a verified sender for production.
RESEND_API_KEY=re_replace_with_resend_api_key
ORDER_NOTIFICATION_EMAIL=cs@bladerxstore.com
ORDER_NOTIFICATION_FROM="BLADERS X Store <orders@your-verified-domain.com>"
