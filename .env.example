# Stripe production secrets. Never commit real secret keys.
STRIPE_SECRET_KEY=replace_with_rotated_stripe_secret_key
STRIPE_PRICE_BLACK=price_replace_with_black_tee_price
STRIPE_PRICE_NAVY=price_replace_with_navy_tee_price
STRIPE_WEBHOOK_SECRET=whsec_replace_me_when_webhook_is_ready

# Supabase project settings. Keep the service role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_service_role_key
